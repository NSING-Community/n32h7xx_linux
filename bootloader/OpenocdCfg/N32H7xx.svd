                <offset>0x0</offset>
                <size>0x400</size>
                <usage>registers</usage>
            </addressBlock>
            <interrupt>         
                <name>LPTIM1_wakeup</name>
                <description>LPTIM1 global interrupt through EXTI line 66</description>
                <value>222</value>                   
            </interrupt>
            <registers>
                <register>
                    <name>LPTIM_INTSTS</name>
                    <displayName>LPTIM_INTSTS</displayName>
                    <description>LPTIM Interrupt and Status Register</description>
                    <addressOffset>0x00</addressOffset>
                    <size>0x20</size>
                    <access>read-only</access>
                    <resetValue>0x00000000</resetValue>
                    <fields>
                        <field>
                            <name>CMPM</name>
                            <description>Compare match</description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>1</bitWidth>
                        </field>
                        <field>
                            <name>ARRM</name>
                            <description>Auto-reload match</description>
                            <bitOffset>1</bitOffset>
                            <bitWidth>1</bitWidth>
                        </field>
                        <field>
                            <name>EXTRIG</name>
                            <description>External trigger valid event</description>
                            <bitOffset>2</bitOffset>
                            <bitWidth>1</bitWidth>
                        </field>
                        <field>
                            <name>CMPUPD</name>
                            <description>Compare value updated to register</description>
                            <bitOffset>3</bitOffset>
                            <bitWidth>1</bitWidth>
                        </field>
                        <field>
                            <name>ARRUPD</name>
                            <description>Auto-reload value updated to register</description>
                            <bitOffset>4</bitOffset>
                            <bitWidth>1</bitWidth>
                        </field>
                        <field>
                            <name>UP</name>
                            <description>Change counter direction up</description>
                            <bitOffset>5</bitOffset>
                            <bitWidth>1</bitWidth>
                        </field>
                        <field>
                            <name>DOWN</name>
                            <description>Change counter direction down</description>
                            <bitOffset>6</bitOffset>
                            <bitWidth>1</bitWidth>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>LPTIM_INTCLR</name>
                    <displayName>LPTIM_INTCLR</displayName>
                    <description>LPTIM Interrupt Clear Register</description>
                    <addressOffset>0x04</addressOffset>
                    <size>0x20</size>
                    <access>write-only</access>
                    <resetValue>0x00000000</resetValue>
                    <fields>
                        <field>
                            <name>CMPMCF</name>
                            <description>Compare match clear flag</description>
                            <bitOffset>0</bitOffset>
                            <bitWidth>1</bitWidth>
                        </field>
                        <field>
                            <name>ARRMCF</name>
                            <description>Auto-reload match clear flag</description>
                            <bitOffset>1</bitOffset>
                            <bitWidth>1</bitWidth>
                        </field>
                        <field>
                            <name>EXTRIGCF</name>
                            <description>External trigger valid edge clear flag</description>
                            <bitOffset>2</bitOffset>
                            <bitWidth>1</bitWidth>
                        </field>
                        <field>
                            <name>CMPUPDCF</name>
                            <description>Compare value updated to register clear flag</description>
                            <bitOffset>3</bitOffset>
                            <bitWidth>1</bitWidth>
