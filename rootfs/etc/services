# BusyBox inetd resolves inetd.conf service names here; there is no numeric
# fallback, so every name used in /run/inetd.conf must be listed.
ssh		22/tcp
# telnet	23/tcp		(retired: cleartext, redundant with ssh)
http		80/tcp
https		443/tcp
domain		53/tcp		domain		53/udp
bootps		67/udp
bootpc		68/udp
ntp		123/udp
sunrpc		111/tcp
