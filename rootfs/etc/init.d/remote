#!/bin/sh
# SPDX-License-Identifier: BSD-3-Clause
#
# Remote login: telnetd and dropbear (ssh), both served by BusyBox inetd.
#
# Dropbear's own listen loop calls fork(), which no-MMU uClibc lacks, so inetd
# owns the listening sockets and spawns one real program per connection
# (vfork+exec, safe here).
#
# no-MMU hush: only background real executables, never a shell compound.
export PATH=/bin:/sbin:/usr/sbin

# Read-only board defaults (/etc/defaults.conf).  Data-only scan; see
# boot-services for the rationale.
conf_get()
{
	if grep -q "^$1=" /etc/defaults.conf 2>/dev/null; then
		sed -n "s/^$1=//p" /etc/defaults.conf | tail -n 1
	else
		printf '%s' "$2"
	fi
}

# Must be writable: /etc is a read-only SquashFS, so transient runtime state
# goes on the /run ramfs.
CONF=/run/inetd.conf
PIDFILE=/run/inetd.pid
LOGFILE=/run/dropbear-keygen.log

# Host key storage.  /etc is a read-only SquashFS and /run is a ramfs, so a key
# kept in either one is regenerated on every boot and every ssh client reports
# a changed host key.  /system is JFFS2, the board's only persistent writable
# filesystem, and the usual update (dtb/kernel/rootfs into spi-nor-boot.img)
# leaves it alone -- so the key is written there once per board and reused.
# A board whose system partition is missing or unmountable falls back to the
# ramfs: ssh still works, the key is just new after every reboot.
PERSIST_KEY_DIR=/system/var/dropbear
VOLATILE_KEY_DIR=/run/dropbear

key_dir()
{
	if mountpoint -q /system && mkdir -p "$PERSIST_KEY_DIR" 2>/dev/null; then
		echo "$PERSIST_KEY_DIR"
	else
		echo "$VOLATILE_KEY_DIR"
	fi
}

inetd_running()
{
	[ -f "$PIDFILE" ] || return 1
	pid=$(cat "$PIDFILE" 2>/dev/null)
	case "$pid" in ''|*[!0-9]*) return 1;; esac
	kill -0 "$pid" 2>/dev/null
}

ensure_host_key()
{
	dir=$1
	key=$dir/dropbear_ed25519_host_key

	mkdir -p "$dir" 2>/dev/null
	chmod 700 "$dir" 2>/dev/null
	if [ -s "$key" ]; then
		echo "REMOTE_HOSTKEY_PRESENT $key"
		return 0
	fi
	# Ed25519 generation is instant on the M7; RSA-2048 would burn boot time
	# and every client here speaks ssh-ed25519.
	/usr/sbin/dropbearkey -t ed25519 -f "$key" >>"$LOGFILE" 2>&1 ||
		return 1
	chmod 600 "$key" 2>/dev/null
	echo "REMOTE_HOSTKEY_GENERATED $key"
}

write_inetd_conf()
{
	mode=$1
	key=$2

	echo '# Generated by /etc/init.d/remote from REMOTE_LOGIN.' > "$CONF"
	echo '# service sock_type proto flags user server args' >> "$CONF"
	case "$mode" in
	telnet|both)
		echo 'telnet stream tcp nowait root /sbin/telnetd telnetd -i' >> "$CONF"
		;;
	esac
	case "$mode" in
	ssh|both)
		# No -E: inetd passes the socket to the child on fd 0/1/2, so
		# dropbear's stderr logging would be written into the SSH byte
		# stream and corrupt the handshake ("Bad packet length").  Without
		# -E it logs via syslog().
		echo "ssh stream tcp nowait root /usr/sbin/dropbear dropbear -i -r $key" >> "$CONF"
		;;
	esac
}

remote_start()
{
	mode=$(conf_get REMOTE_LOGIN both)

	if inetd_running; then
		echo 'REMOTE_ALREADY_RUNNING'
		return 0
	fi
	if [ "$mode" = off ]; then
		echo REMOTE_DISABLED
		return 0
	fi
	if [ ! -x /sbin/inetd ] && [ ! -x /usr/sbin/inetd ]; then
		echo 'WARNING: REMOTE_NO_INETD; the booted userland has no inetd'
		return 1
	fi

	key=none
	if [ "$mode" = ssh ] || [ "$mode" = both ]; then
		if [ ! -x /usr/sbin/dropbear ] || [ ! -x /usr/sbin/dropbearkey ]; then
			echo 'WARNING: REMOTE_NO_DROPBEAR; ssh requested but dropbear is missing'
			return 1
		fi
		dir=$(key_dir)
		if ! ensure_host_key "$dir"; then
			# Not fatal on its own: a /system that is mounted but unwritable,
			# or out of space, must not cost us ssh.  Fall back to a key that
			# dies with the reboot, which is what this board used to do.
			if [ "$dir" = "$PERSIST_KEY_DIR" ]; then
				echo 'WARNING: REMOTE_HOSTKEY_PERSIST_FAILED; retrying on the ramfs'
				dir=$VOLATILE_KEY_DIR
				ensure_host_key "$dir" || dir=none
			else
				dir=none
			fi
			if [ "$dir" = none ]; then
				echo 'WARNING: REMOTE_HOSTKEY_FAILED; see /run/dropbear-keygen.log'
				return 1
			fi
		fi
		if [ "$dir" = "$VOLATILE_KEY_DIR" ]; then
			echo 'WARNING: REMOTE_HOSTKEY_VOLATILE; key changes on reboot'
		fi
		key=$dir/dropbear_ed25519_host_key
	fi

	write_inetd_conf "$mode" "$key"
	# A read-only /etc used to make this write fail silently.
	if [ ! -s "$CONF" ]; then
		echo "WARNING: REMOTE_NO_CONF; cannot write $CONF (read-only root?)"
		return 1
	fi
	: >"$LOGFILE"
	# -f keeps inetd in the foreground so we can record its PID.
	inetd -f "$CONF" >>/run/inetd.log 2>&1 &
	inetd_pid=$!
	echo "$inetd_pid" > "$PIDFILE"
	echo "REMOTE_STARTED mode=$mode pid=$inetd_pid"
}

remote_stop()
{
	if inetd_running; then
		kill "$(cat "$PIDFILE")" 2>/dev/null
	fi
	killall inetd 2>/dev/null
	rm -f "$PIDFILE"
	echo REMOTE_STOPPED
}

remote_status()
{
	mode=$(conf_get REMOTE_LOGIN both)
	if inetd_running; then
		echo "remote: running (mode $mode, pid $(cat "$PIDFILE"))"
	else
		echo "remote: stopped (mode $mode)"
	fi
	if [ -f "$CONF" ]; then
		grep -v '^#' "$CONF"
	fi
	return 0
}

case "${1:-start}" in
start) remote_start;;
stop) remote_stop;;
restart) remote_stop; remote_start;;
status) remote_status;;
	*) echo 'Usage: remote start|stop|restart|status' >&2; exit 2;;
esac
